{
  "name": "beatforge",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based world-rhythm metronome + drum machine. 536 patterns, polyrhythm, speed trainer, step sequencer, and Web MIDI. Free + open source.",
  "homepage": "https://cemergin.github.io/beatforge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cemergin/beatforge.git",
    "directory": "app"
  },
  "bugs": "https://github.com/cemergin/beatforge/issues",
  "license": "MIT",
  "author": "Cem Ergin",
  "keywords": [
    "metronome",
    "world-rhythms",
    "polyrhythm",
    "odd-meter",
    "drum-machine",
    "step-sequencer",
    "web-midi",
    "web-audio",
    "music",
    "practice",
    "rhythm",
    "tabla",
    "gamelan",
    "samba",
    "beat-grouping",
    "pwa",
    "react",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "check": "bun run typecheck",
    "check:lint": "bun run typecheck && bun run lint",
    "check:full": "bun run typecheck && bun run lint && bun run test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate-patterns": "bun scripts/migrate-patterns-to-json.ts",
    "audit-pattern-schema": "bun scripts/audit-pattern-schema.ts",
    "prepare": "git -C .. config core.hooksPath app/scripts/githooks 2>/dev/null || true"
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "fuse.js": "^7.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.0"
  }
}
